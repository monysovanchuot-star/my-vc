<form>
  <label for="fullname">ឈ្មោះ៖</label>
  <input type="text" id="fullname" name="fullname"><br><br>
  <label for="email">អ៊ីមែល៖</label>
  <input type="email" id="email" name="email"><br><br>
  <label for="age">អាយុ៖</label>
  <input type="number" id="age" name="age" min="1" max="120"><br><br>
  <label for="dob">ថ្ងៃខែឆ្នាំកំណើត៖</label>
  <input type="date" id="dob" name="dob"><br><br>
  <label for="password">ពាក្យសម្ងាត់៖</label>
  <input type="password" id="password" name="password"><br><br>
  <input type="checkbox" id="terms" name="terms">
  <label for="terms">ខ្ញុំយល់ព្រមតាមលក្ខខណ្ឌ</label><br><br>
  <label for="avatar">រូបភាព Profile៖</label>
  <input type="file" id="avatar" name="avatar" accept="image/*">
</form>


